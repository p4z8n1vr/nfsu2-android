<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="GameControllerSlot">
        <item name="android:layout_width">@dimen/controller_slot_size</item>
        <item name="android:layout_height">@dimen/controller_slot_size</item>
    </style>

    <style name="GameControllerButton">
        <item name="android:layout_width">@dimen/controller_button_size</item>
        <item name="android:layout_height">@dimen/controller_button_size</item>
        <item name="android:layout_margin">@dimen/controller_button_margin</item>
        <item name="android:background">@drawable/controller_button</item>
        <item name="android:textColor">@color/controller_text</item>
        <item name="android:textSize">@dimen/controller_text_size</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="GameControllerMenuButton" parent="GameControllerButton">
        <item name="android:layout_width">@dimen/controller_menu_width</item>
    </style>

    <style name="GameControllerShoulderButton" parent="GameControllerButton">
        <item name="android:layout_width">@dimen/controller_shoulder_width</item>
    </style>
</resources>
