<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:splitMotionEvents="true"
    android:background="@color/launcher_background">

    <SurfaceView
        android:id="@+id/game_boot_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/controller_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:splitMotionEvents="true">

        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="@dimen/controller_outer_margin"
            android:layout_marginBottom="@dimen/controller_outer_margin"
            android:columnCount="3"
            android:rowCount="3">

            <Space style="@style/GameControllerSlot" />
            <Button
                android:id="@+id/controller_up"
                style="@style/GameControllerButton"
                android:text="@string/controller_up" />
            <Space style="@style/GameControllerSlot" />

            <Button
                android:id="@+id/controller_left"
                style="@style/GameControllerButton"
                android:text="@string/controller_left" />
            <Space style="@style/GameControllerSlot" />
            <Button
                android:id="@+id/controller_right"
                style="@style/GameControllerButton"
                android:text="@string/controller_right" />

            <Space style="@style/GameControllerSlot" />
            <Button
                android:id="@+id/controller_down"
                style="@style/GameControllerButton"
                android:text="@string/controller_down" />
            <Space style="@style/GameControllerSlot" />
        </GridLayout>

        <FrameLayout
            android:layout_width="@dimen/controller_cluster_size"
            android:layout_height="@dimen/controller_cluster_size"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/controller_outer_margin"
            android:layout_marginBottom="@dimen/controller_outer_margin">

            <Button
                android:id="@+id/controller_y"
                style="@style/GameControllerButton"
                android:layout_gravity="top|center_horizontal"
                android:text="@string/controller_y" />

            <Button
                android:id="@+id/controller_x"
                style="@style/GameControllerButton"
                android:layout_gravity="center_vertical|start"
                android:text="@string/controller_x" />

            <Button
                android:id="@+id/controller_b"
                style="@style/GameControllerButton"
                android:layout_gravity="center_vertical|end"
                android:text="@string/controller_b" />

            <Button
                android:id="@+id/controller_a"
                style="@style/GameControllerButton"
                android:layout_gravity="bottom|center_horizontal"
                android:text="@string/controller_a" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="@dimen/controller_outer_margin"
            android:orientation="horizontal">

            <Button
                android:id="@+id/controller_back"
                style="@style/GameControllerMenuButton"
                android:text="@string/controller_back" />

            <Button
                android:id="@+id/controller_start"
                style="@style/GameControllerMenuButton"
                android:text="@string/controller_start" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="@dimen/controller_outer_margin"
            android:layout_marginTop="@dimen/controller_outer_margin"
            android:orientation="horizontal">

            <Button
                android:id="@+id/controller_lt"
                style="@style/GameControllerShoulderButton"
                android:text="@string/controller_lt" />

            <Button
                android:id="@+id/controller_white"
                style="@style/GameControllerShoulderButton"
                android:text="@string/controller_white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginEnd="@dimen/controller_outer_margin"
            android:layout_marginTop="@dimen/controller_outer_margin"
            android:orientation="horizontal">

            <Button
                android:id="@+id/controller_black"
                style="@style/GameControllerShoulderButton"
                android:text="@string/controller_black" />

            <Button
                android:id="@+id/controller_rt"
                style="@style/GameControllerShoulderButton"
                android:text="@string/controller_rt" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/game_boot_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:padding="@dimen/launcher_padding"
        android:background="@color/launcher_background"
        android:text="@string/game_boot_initializing"
        android:textColor="@color/status_text"
        android:textSize="@dimen/status_text_size" />

</FrameLayout>
